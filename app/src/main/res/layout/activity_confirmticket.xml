<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    tools:context=".Confirmticket">

    <!-- ===== TOP HEADER - "Pilih kursi" ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="3dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/backCard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/background_light">

            <ImageView
                android:id="@+id/backarrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/backarrow"
                app:tint="@color/text_primary" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih kursi"
                android:textSize="17sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terminal Pulo Gebang, Jakarta → Bandung"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/infoicon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/info"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- ===== MAIN SCROLLABLE BODY ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ===== VEHICLE CABIN CARD (HiAce Executive 1+1 Shuttle) ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="24dp">

                    <!-- Steering wheel icon (Front right) -->
                    <ImageView
                        android:id="@+id/steeringIcon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:src="@drawable/ic_steering_wheel" />

                    <!-- ROW 1: Seat 1 (Left) -->
                    <ImageView
                        android:id="@+id/L11"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_below="@id/steeringIcon"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="16dp"
                        android:src="@drawable/ic_seat_available"
                        android:tag="false"
                        android:onClick="Onselectedseat" />

                    <!-- ROW 2: Seat 2 (Center-Left) & Seat 3 (Right - Booked) -->
                    <ImageView
                        android:id="@+id/L21"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_below="@id/L11"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="38dp"
                        android:layout_marginTop="14dp"
                        android:src="@drawable/ic_seat_available"
                        android:tag="false"
                        android:onClick="Onselectedseat" />

                    <ImageView
                        android:id="@+id/R21"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignTop="@id/L21"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_seat_reserved"
                        android:tag="reserved"
                        android:onClick="Onselectedseat" />

                    <!-- ROW 3: Seat 4 (Left - Booked) & Seat 5 (Right) -->
                    <ImageView
                        android:id="@+id/L31"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_below="@id/L21"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="14dp"
                        android:src="@drawable/ic_seat_reserved"
                        android:tag="reserved"
                        android:onClick="Onselectedseat" />

                    <ImageView
                        android:id="@+id/R31"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignTop="@id/L31"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_seat_available"
                        android:tag="false"
                        android:onClick="Onselectedseat" />

                    <!-- ROW 4 (Back row): Seat 6, 7, 8 (Left, Center, Right) -->
                    <ImageView
                        android:id="@+id/L41"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_below="@id/L31"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="14dp"
                        android:src="@drawable/ic_seat_available"
                        android:tag="false"
                        android:onClick="Onselectedseat" />

                    <ImageView
                        android:id="@+id/L42"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignTop="@id/L41"
                        android:layout_centerHorizontal="true"
                        android:src="@drawable/ic_seat_available"
                        android:tag="false"
                        android:onClick="Onselectedseat" />

                    <ImageView
                        android:id="@+id/R41"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignTop="@id/L41"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_seat_available"
                        android:tag="false"
                        android:onClick="Onselectedseat" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== "Ketahui jenis kursi Anda" SECTION ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ketahui jenis kursi Anda"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="14dp" />

            <!-- Legend Table Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jenis"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tempat duduk"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- Row 1: Tersedia -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tersedia"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_seat_available" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- Row 2: Sudah dipesan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sudah dipesan"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_seat_reserved" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- Row 3: Dipilih -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dipilih"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_seat_selected" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== PERSISTENT BOTTOM SHEET / ACTION PANEL ===== -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <!-- Drag handle icon (caret up) -->
            <ImageView
                android:layout_width="28dp"
                android:layout_height="12dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_baseline_arrow_drop_down_24"
                android:rotation="180"
                app:tint="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <!-- Operator and Rating row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/operatorTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sinar Jaya Shuttle"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/operatorSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15:30 - 17:30 · Sab, 24 Okt"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Rating badge (Green pill) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/rating_green_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★ 4.6"
                            android:textSize="11sp"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Vehicle photo thumbnails preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp">

                <!-- Video Thumbnail -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="6dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#D1D5DB">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/busfront"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:41"
                            android:textSize="9sp"
                            android:textColor="@color/white"
                            android:background="@drawable/badge_green_bg"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Photo 2 (Van Front) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1.4"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/busfinal"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Selected seat details & price -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/selectedSeatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih 1 kursi di atas"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/priceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 120.000"
                        android:textSize="18sp"
                        android:textColor="@color/red_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Confirm / Lanjut button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirmticket"
                    android:layout_width="160dp"
                    android:layout_height="48dp"
                    android:text="Lanjutkan"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/red_primary"
                    app:cornerRadius="24dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>